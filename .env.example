# Copy to .env.development for local dev. Never commit real values (.gitignore covers .env*).

# Database (Neon PostgreSQL connection string)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Cloudinary (untuk upload gambar)
CLOUDINARY_URL=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth (daftar di Google Cloud Console)
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Application URLs
NEXTAUTH_URL=http://127.0.0.1:3000
NEXT_PUBLIC_URL=http://127.0.0.1:3000

# Better Auth session encryption secret, dev-only value, regenerate for production
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Owner email (diberikan oleh owner, otomatis role Platform Owner saat login pertama)
OWNER_EMAIL=your_email_here@gmail.com

# Optional: Xendit (Fase 5, bayar setoran tabungan otomatis)
# XENDIT_API_KEY dari Xendit Dashboard > Settings > API Keys.
# XENDIT_CALLBACK_TOKEN dari Settings > Callbacks > Verification Token —
# daftarkan <NEXTAUTH_URL>/api/webhooks/xendit sebagai Invoice Callback URL-nya.
# Tombol "Bayar via Xendit" hanya muncul kalau XENDIT_API_KEY sudah diisi asli.
XENDIT_API_KEY=your_xendit_api_key_here
XENDIT_CALLBACK_TOKEN=your_xendit_callback_token_here

# Optional: slug creator Trakteer untuk tombol donasi sukarela di landing page
NEXT_PUBLIC_TRAKTEER_SLUG=

# Optional: Google Search Console (kode verifikasi HTML tag) & Google Analytics (GA4)
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Trakteer — nyawa platform per tenant
# NEXT_PUBLIC_TRAKTEER_SLUG: slug creator (tombol Dukung muncul kalau diisi)
# TRAKTEER_WEBHOOK_TOKEN: samakan dengan token di dashboard Trakteer; callback
#   didaftarkan ke <NEXTAUTH_URL>/api/webhooks/trakteer
# TRAKTEER_RUPIAH_PER_HARI: berapa rupiah = 1 hari masa aktif (default 1000)
TRAKTEER_WEBHOOK_TOKEN=
TRAKTEER_RUPIAH_PER_HARI=1000
