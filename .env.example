# Copy to .env.development for local dev. Never commit real values (.gitignore covers .env*).

# --- Database (Neon Postgres) ------------------------------------------------
# Pooled connection (app runtime, via Neon's pooler).
DATABASE_URL=
# Direct connection (Prisma Migrate, no pooling).
DIRECT_URL=

# --- Better Auth --------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Dev: http://127.0.0.1:3000 or the tunnel https://dev.thedreamcompany.space
# Prod: https://guyub.thedreamcompany.space
BETTER_AUTH_URL=http://127.0.0.1:3000

# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ------
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudinary (logo tenant, foto profil, dokumen) ---------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
